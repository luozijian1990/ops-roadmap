[Unit]
Description=Ops Roadmap local learning fixture
After=network.target

[Service]
User=ops-lab
Group=ops-lab
WorkingDirectory=/opt/ops-lab
ExecStart=/usr/bin/python3 /opt/ops-lab/app.py --state /var/lib/ops-lab
StateDirectory=ops-lab
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
