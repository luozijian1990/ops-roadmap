    { "id": "queue", "lane": "capacity", "col": 5, "type": "messagebus", "label": "队列与临时端口", "sublabel": "somaxconn / backlog" },
    { "id": "softirq", "lane": "system", "col": 5, "type": "cloud", "label": "软中断与事件循环", "sublabel": "均衡且不能阻塞", "width": 150 }
  ],
  "edges": [
    { "id": "blocking-select", "from": "blocking", "to": "select", "label": "单线程多 fd", "role": "main" },
