    { "id": "fd", "lane": "capacity", "col": 3, "type": "backend", "label": "文件描述符", "sublabel": "ulimit / file-max" },
    { "id": "memory", "lane": "capacity", "col": 4, "type": "database", "label": "连接内存", "sublabel": "缓冲与对象 × N" },
