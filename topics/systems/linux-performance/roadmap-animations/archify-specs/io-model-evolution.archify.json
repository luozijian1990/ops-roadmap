    { "id": "epoll", "lane": "model", "col": 3, "type": "database", "label": "epoll", "sublabel": "只返回就绪事件" },
    { "id": "lt", "lane": "event", "col": 2, "type": "backend", "label": "水平触发 LT", "sublabel": "可读写就持续通知" },
