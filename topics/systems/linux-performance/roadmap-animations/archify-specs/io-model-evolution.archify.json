    { "id": "epoll-fd", "from": "epoll", "to": "fd", "label": "规模放大", "role": "branch" },
    { "id": "fd-memory", "from": "fd", "to": "memory", "label": "固定成本", "role": "branch" },
    { "id": "memory-state", "from": "memory", "to": "state", "label": "连接状态", "role": "branch" },
    { "id": "state-queue", "from": "state", "to": "queue", "label": "资源边界", "role": "branch" },
    { "id": "queue-softirq", "from": "queue", "to": "softirq", "label": "整机协同", "role": "branch" }
  ],
  "cards": [
    { "dot": "cyan", "title": "选择建议", "items": ["先用 LT 保证正确，再评估 ET", "ET 必须非阻塞并读到 EAGAIN"] },
    { "dot": "amber", "title": "C1000K 检查", "items": ["fd、内存、conntrack、队列", "网卡多队列与 reactor 不阻塞"] }
  ]
