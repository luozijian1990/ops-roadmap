{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "从 C10K 到 C1000K：I/O 模型演进",
    "locale": "zh-CN",
    "animation": "trace",
    "quality_profile": "showcase",
    "viewBox": [1100, 700],
    "views": [
      { "id": "evolution", "label": "模型演进", "focus": ["blocking", "select", "poll", "epoll"], "note": "并发模型逐步从每连接一线程演进到只处理就绪事件。" },
      { "id": "trigger", "label": "epoll 触发", "focus": ["lt", "et", "nonblock", "eagain"], "note": "ET 需要非阻塞并读到 EAGAIN，LT 更容易正确使用。" },
      { "id": "capacity", "label": "C1000K 资源墙", "focus": ["fd", "memory", "state", "queue", "softirq"], "note": "百万连接会同时放大 fd、内存、队列和软中断成本。" }
    ]
  },
  "lanes": [{ "id": "model", "label": "并发模型" }, { "id": "event", "label": "事件语义" }, { "id": "capacity", "label": "容量边界" }, { "id": "system", "label": "系统边界" }],
  "phases": [
    { "id": "old", "label": "传统模型", "fromCol": 0, "toCol": 0 },
    { "id": "multiplex", "label": "I/O 多路复用", "fromCol": 1, "toCol": 3, "variant": "emphasis" },
    { "id": "scale", "label": "百万连接", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["blocking", "select", "poll", "epoll"],
  "nodes": [
    { "id": "blocking", "lane": "model", "col": 0, "type": "frontend", "label": "阻塞 I/O", "sublabel": "一连接一线程" },
    { "id": "select", "lane": "model", "col": 1, "type": "backend", "label": "select", "sublabel": "线性扫描 fd 集合" },
